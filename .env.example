# ===========================================================================
# AROGYASETU — environment variables
# Copy this file to `.env.local` for local dev (never commit .env.local).
# On Vercel, set the same NEXT_PUBLIC_* + server vars in Project → Settings →
# Environment Variables. On Supabase, set the LLM vars as Edge Function
# secrets (see README "Supabase setup").
#
# EVERY service below has a permanently-free tier. No paid infra is required.
# The app runs in a graceful "demo mode" even with NONE of these set.
# ===========================================================================

# ---------------------------------------------------------------------------
# Supabase (free tier) — REQUIRED for the live (non-demo) backend.
# Project → Settings → API. The anon key is safe to expose to the browser
# (RLS protects every table); the service role key is SERVER-ONLY.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-KEY

# Service role key — used ONLY by scripts/seed-demo.ts and (as a Supabase
# secret) by the Edge Functions. NEVER expose to the browser, NEVER prefix
# with NEXT_PUBLIC_. Do not set this in the Vercel *client* build.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SUPABASE-SERVICE-ROLE-KEY

# ---------------------------------------------------------------------------
# Free-tier LLM provider (swappable). Set ONE provider + its key. The chain
# falls through in this order and finally to a static template library, so the
# app still works if a provider is rate-limited/down or if none is configured.
#   groq        → https://console.groq.com  (fast, generous free tier)
#   openrouter  → https://openrouter.ai     (has :free models)
#   gemini      → https://aistudio.google.com/app/apikey  (Google AI Studio)
#   huggingface → https://huggingface.co/settings/tokens
# Set the SAME values as Supabase Edge Function secrets for the edge path.
# ---------------------------------------------------------------------------
LLM_PROVIDER=groq

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

HUGGINGFACE_API_KEY=
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

# ---------------------------------------------------------------------------
# Environmental data: Open-Meteo — keyless & free. No variable needed.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# (Optional) Web Push VAPID keys for Care Ping desktop notifications.
# Generate with:  npx web-push generate-vapid-keys
# The public key may be exposed to the browser; keep the private key server-side.
# Push is OPTIONAL — Care Pings also arrive via Supabase Realtime + in-app.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
